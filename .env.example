# Browser-safe values. These are public and are safe to expose in the built frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy projects may use this instead of VITE_SUPABASE_PUBLISHABLE_KEY
# VITE_SUPABASE_ANON_KEY=your_legacy_anon_public_key

# Provisioning only; never put this in VITE_* variables, the frontend, GitHub, or Cloudflare build output.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_your_key
# Legacy projects may use this instead:
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
